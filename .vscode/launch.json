{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Dependency Scan Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/out/**/*.js"
      ],
      "preLaunchTask": "vscode: compile"
    }
  ]
}
