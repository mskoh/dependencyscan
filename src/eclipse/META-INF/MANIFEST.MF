Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Dependency Scan
Bundle-SymbolicName: dependencyscan.eclipse;singleton:=true
Bundle-Version: 0.1.0.qualifier
Bundle-Activator: dependencyscan.eclipse.Activator
Bundle-Vendor: dependencyscan
Require-Bundle: org.eclipse.ui,
